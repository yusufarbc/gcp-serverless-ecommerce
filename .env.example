# ==============================================================================
# GCP SERVERLESS EUROPEAN E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION
# Region: europe-west3 (Frankfurt am Main, Germany)
# Architecture: $0.00 Idle Cost Serverless Demo with graceful sandbox fallback
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE GCP INFRASTRUCTURE
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=gcp-serverless-ecommerce
GCP_REGION=europe-west3
ENVIRONMENT=production
NODE_ENV=production
STORE_NAME="Apex Direct Europe"
PORT=9000

# Google Cloud Storage Bucket for product media and PDF invoices
GCS_BUCKET_NAME=gcp-serverless-ecommerce-media

# Cloud Tasks Queue name for asynchronous workers
CLOUD_TASKS_QUEUE=ecommerce-tasks

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE LAYER (PostgreSQL / Cloud SQL)
# Leave as PLACEHOLDER to run in $0-cost Serverless In-Memory Demo Mode
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:PLACEHOLDER_DB_PASSWORD@34.141.100.10:5432/apex_ecommerce?sslmode=require

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAYS (Stripe, PayPal, Google Pay)
# Uses built-in simulation / sandbox mode when placeholder keys are present
# ------------------------------------------------------------------------------
# Stripe (Credit Cards, iDEAL, Klarna, Bancontact)
STRIPE_SECRET_KEY=sk_test_placeholder_51NxXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_51NxXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_placeholder_xxxxxxxxxxxxxxxxxxxxxxxxxx

# PayPal Checkout v2
PAYPAL_CLIENT_ID=AeA_placeholder_client_id_for_demo
PAYPAL_CLIENT_SECRET=EL_placeholder_secret_for_demo
PAYPAL_MODE=sandbox

# Google Pay Business Console
GOOGLE_PAY_MERCHANT_ID=BCR2DN4T_PLACEHOLDER_MERCHANT_ID
GOOGLE_PAY_MERCHANT_NAME="Apex Direct Europe Demo"
GOOGLE_PAY_ENVIRONMENT=TEST

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL & INVOICING (Resend / SendGrid / SMTP)
# Automatically records to in-memory outbox when placeholder keys are used
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_placeholder_xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.placeholder_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=orders@apexstore.eu

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD TRANSLATION API (Pan-EU Support Desk)
# Translates IT, DE, FR, ES, NL inquiries to English and replies back
# ------------------------------------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=AIzaSy_PLACEHOLDER_TRANSLATE_API_KEY

# ------------------------------------------------------------------------------
# 6. SERVER-SIDE GOOGLE TAG MANAGER (sGTM) & FIRST-PARTY TRACKING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SGTM_DOMAIN=ss.apexstore.eu
CONTAINER_CONFIG=aWQ9R1RNLVhYWFhYWA== # Base64 encoded 'id=GTM-XXXXXX'
PREVIEW_SERVER_URL=https://ss-staging.apexstore.eu

# ------------------------------------------------------------------------------
# 7. EU OSS TAX & LEGAL COMPLIANCE
# ------------------------------------------------------------------------------
COMPANY_NAME="Apex Direct Europe GmbH"
COMPANY_ADDRESS="Friedrichstraße 123"
COMPANY_CITY="10117 Berlin"
EU_OSS_VAT_ID=DE345678901
